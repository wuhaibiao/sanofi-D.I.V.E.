  "roles": {
    "_说明": "memory 负责新增记忆的单次抽取；embedding 负责向量；最终回答由宿主 Agent 生成。默认直接检索与 BGE 重排，不调用更新裁决、查询规划或答案复查。",
    "chat": "opencode-gpt-6-luna",
    "memory": "opencode-gpt-6-luna",
    "embedding": "bge-m3",
    "judge": "opencode-gpt-6-luna",
    "query": "opencode-gpt-6-luna",
    "extract": "opencode-gpt-6-luna"
  },
  "fallbacks": {},
  "memory": {
    "_说明": "这里只列了最常调的几个参数，完整参数和默认值见 src/memsys/config.py 的 MemorySettings。",
    "recall_mode": "facts",
    "_召回说明": "默认长期记忆只检索、重排和返回事实，不自动附来源原文或待整理的跨会话原文。facts_and_sources 仅用于显式诊断；原文仍可通过 sources 接口查阅。",
    "context_budget_tokens": 32000,
    "max_active_facts": 5000,
    "max_active_episodes": 2000,
    "_容量说明": "活跃条目超限按保留分归档；null 可关闭相应限制。SQLite 分配页默认256MiB，超限且增长的事务回滚。WAL与备份不计入此上限；物理缩减通过 cleanup 预览、备份后执行。",
    "_抽取说明": "参考 Mem0：整批新消息、相关旧记忆和最近消息进入一次抽取；不按输入长度切块或截断，不拆分重抽。模型拒绝、超限、输出截断或格式错误时保留原文并报告失败。Embedding 的角色分段仅用于向量索引。",
    "query_focused_excerpts": true,
    "_向量说明": "完整原文按角色分段编码；旧库执行 reindex 后获得分段索引。关闭 episode_chunk_vectors 并重建可对照旧前缀模式。",
    "episode_chunk_vectors": true,
    "embed_chunk_tokens": 384,
    "embed_chars": 2000,
    "_计算说明": "核对模型提交的计算凭据，失败时修正一次；没有凭据或引用/单位不明确时记录为未验证，不能证明事件选取和召回完整性。",
    "aggregation_validation": false,
    "semantic_validation": true,
    "_阈值说明": "min_similarity 是检索相关性阈值；精确文本去重不使用相似度阈值，也不调用更新裁决模型。",
    "min_similarity": 0.4,
    "query_analysis": false,
    "_query_expansion": "没有语义 embedding（只有本地哈希向量）时建议设为 true：查询分析多给同义词，补关键词检索的召回",
    "query_expansion": false,
    "budget_mode": "utf8",
    "budget_tokenizer_path": "",
    "answer_input_budget_tokens": 131072,
    "memory_input_budget_tokens": 16384,
    "_预算说明": "默认按 UTF-8 字节保守限制内容，参数名保留 tokens；tokenizer 模式需匹配模型的本地 tokenizer.json 和 strict 可选依赖。完整消息另预留每条8单位；服务端实际 token 取 usage。estimate 仅供旧估算消融。",
    "max_storage_bytes": 268435456,
    "aggregate_candidate_limit": 5000,
    "aggregate_contribution_limit": 5000,
    "aggregate_max_pages": 128,
    "aggregate_page_items": 20,
    "_聚合分页说明": "聚合扫描当前与归档候选，超出单块上下文后逐页核验并合并同单位求和或明确名称去重计数。扫描、页数或贡献上限、证据核验失败时拒绝完整合计；语义相关性与事件身份仍需模型判断。",
    "_检索重构说明": "普通角色分块 + 本地 BGE 重排。安装 memsys[rerank]；固定模型与 tokenizer revision。CPU/float32 可跨设备使用，本机配置采用已验证的 MPS/float32、batch 4。rerank_strict=true 时失败直接报错；false 时记录错误并保留融合排名。",
    "rerank_backend": "bge",
    "rerank_model": "BAAI/bge-reranker-v2-m3",
    "rerank_revision": "953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e",
    "rerank_tokenizer_revision": "953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e",
    "rerank_device": "cpu",
    "rerank_dtype": "float32",
    "rerank_batch_size": 4,
    "rerank_max_tokens": 512,
    "rerank_overlap_tokens": 32,
    "rerank_strict": false,
    "chunk_strategy": "legacy",
    "_分块计数说明": "按角色连续分块，原文字符区间用于追溯。embed_chunk_tokens 沿用所选 budget_mode 的计数单位；默认 utf8 表示字节保守上界。BGE 重排另按自己的 tokenizer 计算配对 token，切换重排不重抽事实。",
    "query_policy": "off",
    "query_low_confidence": 0.65,
    "semantic_operation_validation": null,
    "cross_page_semantic_validation": null,
    "answer_review_policy": "off",
    "_复核策略说明": "legacy 沿用 semantic_validation；显式 always/on_risk/off 只控制回答模型复核。semantic_operation_validation 和 cross_page_semantic_validation 独立控制操作语义及分页处理，null 沿用旧开关。程序计算、日期、引用校验始终由 aggregation_validation 独立控制。",
    "embedding_model_revision": "unknown",
    "_embedding_revision说明": "embedding_model_revision 记录服务端不可变 revision 或 digest；unknown 表示原库未记录底层 revision。改变它会使写入缓存失效，reindex 会重算事实向量以避免混用；不能用 tokenizer revision 代替权重身份。",
    "rerank_candidates": 60,
    "read_timeout_s": 600.0,
    "read_retries_per_call": 1,
    "read_retries_total": 2,
    "read_retry_wait_s": 30.0,
    "complete_context_skip_rerank": true,
    "complete_context_direct_query": true,
    "relations_enabled": true,
    "relation_hops": 2,
    "relation_seed_facts": 6,
    "relation_max_nodes": 32,
    "relation_max_edges": 96,
    "relation_max_candidates": 32,
    "answer_fact_limit": 128,
    "chat_window_turns": 12,
    "chat_window_tokens": 12000,
    "min_context_tokens": 1500,
    "extract_max_tokens": 65536,
    "answer_max_tokens": 8192,
    "answer_max_tokens_limit": 32768,
    "extract_max_tokens_limit": 131072
  },
